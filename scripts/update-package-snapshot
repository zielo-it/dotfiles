#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
DOTFILES_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
OUTPUT="${1:-$DOTFILES_DIR/packages/arch-explicit.txt}"

if [ "$#" -gt 1 ]; then
  printf 'Usage: update-package-snapshot [OUTPUT]\n' >&2
  exit 2
fi

if ! command -v pacman >/dev/null 2>&1; then
  printf 'Error: this helper requires pacman.\n' >&2
  exit 1
fi

mkdir -p -- "$(dirname -- "$OUTPUT")"
temporary="$(mktemp --tmpdir="$(dirname -- "$OUTPUT")" .packages.XXXXXX)"
trap 'rm -f -- "$temporary"' EXIT

pacman -Qqen | LC_ALL=C sort -u > "$temporary"

if [ -f "$OUTPUT" ] && cmp -s -- "$temporary" "$OUTPUT"; then
  printf 'Package snapshot is already current: %s\n' "$OUTPUT"
  exit
fi

chmod 0644 "$temporary"
mv -- "$temporary" "$OUTPUT"
trap - EXIT
printf 'Updated explicit package snapshot: %s\n' "$OUTPUT"
