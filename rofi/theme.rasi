* {
    bg: #1e1e2eff;
    surface: #313244ff;
    fg: #cdd6f4ff;
    muted: #6c7086ff;
    accent: #89b4faff;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 42%;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    background-color: @bg;
}

mainbox {
    padding: 12px;
    spacing: 10px;
}

inputbar {
    padding: 10px;
    spacing: 8px;
    border-radius: 6px;
    background-color: @surface;
}

prompt {
    text-color: @accent;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px;
    spacing: 8px;
    border-radius: 5px;
}

element selected.normal {
    background-color: @surface;
    text-color: @accent;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
