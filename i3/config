set $mod Mod4
set $term alacritty
set $menu rofi -show drun

font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod
focus_follows_mouse no
workspace_auto_back_and_forth yes
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 8
gaps outer 4

set $bg       #1e1e2e
set $surface  #313244
set $fg       #cdd6f4
set $muted    #6c7086
set $accent   #89b4fa
set $urgent   #f38ba8

client.focused          $accent  $accent  $bg      $accent  $accent
client.focused_inactive $surface $surface $fg      $surface $surface
client.unfocused        $bg      $bg      $muted   $bg      $bg
client.urgent           $urgent  $urgent  $bg      $urgent  $urgent
client.placeholder      $bg      $bg      $fg      $bg      $bg
client.background       $bg

bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+e exec --no-startup-id thunar
bindsym $mod+w exec --no-startup-id firefox
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/wallpaper next
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1e1e2e
bindsym Print exec --no-startup-id flameshot gui
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Print exec --no-startup-id flameshot full -c

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioStop exec --no-startup-id playerctl stop
bindsym XF86MonBrightnessUp exec --no-startup-id ~/dotfiles/scripts/brightness-status up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/dotfiles/scripts/brightness-status down

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+q kill
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+space layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+Control+space focus mode_toggle
bindsym $mod+a focus parent

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'End the i3 session?' -B 'Yes' 'i3-msg exit'"

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

exec_always --no-startup-id setxkbmap -layout pl
exec_always --no-startup-id xset r rate 250 35
exec_always --no-startup-id ~/dotfiles/scripts/brightness-status sync
exec_always --no-startup-id ~/.local/bin/wallpaper watch
exec_always --no-startup-id ~/dotfiles/scripts/apply-dark-mode
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id dunst
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id /usr/bin/touchegg
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 1e1e2e

bar {
    position top
    status_command i3status --config ~/.config/i3status/config
    tray_output primary
    font pango:JetBrainsMono Nerd Font 10

    colors {
        background $bg
        statusline $fg
        separator $muted
        focused_workspace  $accent  $accent  $bg
        active_workspace   $surface $surface $fg
        inactive_workspace $bg      $bg      $muted
        urgent_workspace   $urgent  $urgent  $bg
        binding_mode       $urgent  $urgent  $bg
    }
}
